#!/usr/bin/env bash
# migration-gate — Stop hook: refuses to end the turn while a migration in progress is not re-verified.
#
# Opt-in by design. It does nothing unless the project carries the marker `.migration/gate-required`, which the
# lutece-update-plugin skill drops when its gate loop starts and which only a full final-gate.sh,
# e2e included, removes: a green gate without e2e lets the turn end but keeps the marker. Without that marker every
# other session ends normally.
#
# Why a hook and not a rule in the skill: a rule is skipped by whoever is convinced their last edit was harmless.
# Exit 2 blocks the stop and hands the reason back to the agent, which is the only deterministic way to make
# "I re-measured after my last edit" true.
set -uo pipefail

MARKER=".migration/gate-required"
[ -f "$MARKER" ] || exit 0

# Never loop: a second stop in the same turn lets the agent through with the failure reported.
STAMP=".migration/.gate-ran"
if [ -f "$STAMP" ] && [ "$(find "$STAMP" -mmin -2 2>/dev/null)" ]; then
    exit 0
fi
mkdir -p .migration && touch "$STAMP"

GATE="${CLAUDE_PLUGIN_ROOT:-}/tools/final-gate.sh"
[ -x "$GATE" ] || exit 0

# A gate or a bench run already holds the bench lock: its own verdict is on its way, and a second gate would only be
# refused by that lock. The turn may end while the agent waits for it.
if [ -s e2e/.run.lock/pid ] && kill -0 "$(cat e2e/.run.lock/pid)" 2>/dev/null; then
    rm -f "$STAMP"
    exit 0
fi

if OUT=$(bash "$GATE" . --no-e2e 2>&1); then
    rm -f "$STAMP"
    exit 0
fi

{
    echo "The gate is red, so this update is not done."
    echo "$OUT" | sed "s/$(printf '\033')\[[0-9;]*m//g" | grep -E "^(FAIL|OK)|GATE" | tail -12
    echo
    echo "Fix what is red, then run the gate again:"
    echo "  bash \${LUTECEPOWERS_ROOT}/tools/final-gate.sh ."
    echo "final-gate.sh removes .migration/gate-required itself once the full gate, e2e included, passes."
} >&2
exit 2
